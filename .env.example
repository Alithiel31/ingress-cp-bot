# Copy this file to ".env" and fill in the values. Never commit ".env".
# Copie ce fichier en ".env" et renseigne les valeurs. Ne commite jamais ".env".

# Telegram bot token from @BotFather (required)
# Token du bot obtenu auprès de @BotFather (obligatoire)
TELEGRAM_TOKEN=

# Display timezone (optional, default: Europe/Paris)
# Fuseau d'affichage (optionnel, défaut : Europe/Paris)
BOT_TZ=Europe/Paris

# res.blue (OneRing) API key (optional). If set, only agents approved on 1R can use the commands.
# Leave empty for a public bot. Never commit it.
# Clé API res.blue / OneRing (optionnelle). Si renseignée, seuls les agents approuvés sur 1R
# peuvent utiliser les commandes. Laisse vide pour un bot public. Ne la commite jamais.
ONERING_APIKEY=
